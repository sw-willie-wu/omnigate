downloads/
logs/
state.toml
*.log
*.log.1
wuwa_uid_cache.json

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# tooling
.claude/
.playwright-mcp/

# secrets / local
.env
.env.local
settings.toml

# runtime state written to CWD when running the dev exe from repo root
/playstate.json
/gacha.db

# portable single-file data layout (omnigate.db) — written to dataDir, which in
