# brainstorming companion (mockups + state, not production)
.superpowers/

# build output
build/bin/
dist/
node_modules/
frontend/dist/
frontend/node_modules/

# Wails generated bindings (regenerated on build)
frontend/wailsjs/
frontend/package.json.md5

# Go build artefacts
*.exe
*.dll

# Exceptions for test fixtures
!internal/providers/iconext/testdata/*.exe

# Exceptions for vendored binaries
!internal/patch/hpatchz/third_party_hpatchz/hpatchz.exe
!internal/providers/hoyoverse/sevenzip/third_party_7zr/7zr.exe

